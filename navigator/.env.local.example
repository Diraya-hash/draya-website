# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---------------------------------------------------------------
# For LOCAL Supabase, run `npm run db:start` and copy the printed values.
# (Local anon/service keys are the standard fixed demo keys — safe to use.)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — used ONLY by the seed script (never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=


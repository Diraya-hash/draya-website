# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (HOSTED) ------------------------------------------------------
# Create a free project at https://supabase.com, then:
#   Project Settings → API  →  Project URL + anon public key
#   Project Settings → API  →  service_role key (KEEP SECRET; seed/scripts only)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — used ONLY by seed/verify scripts (never shipped to browser).
SUPABASE_SERVICE_ROLE_KEY=

# Also set NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY in the
# Vercel project's Environment Variables so production uses the live DB.

# --- AI (Phase 3+: CV parsing, AI report prose) ----------------------------
# ANTHROPIC_API_KEY=
